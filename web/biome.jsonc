{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["ultracite/biome/core", "ultracite/biome/next"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"!node_modules",
			"!.next",
			"!dist",
			"!build",
			"!src/styles/**/*.css"
		]
	},
	"css": {
		"parser": {
			"cssModules": true
		},
		"linter": {
			"enabled": false
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab",
			"indentWidth": 4
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 170,
		"formatWithErrors": true,
		"bracketSpacing": true,
		"bracketSameLine": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useButtonType": "off",
				"noStaticElementInteractions": "off",
				"useKeyWithClickEvents": "off"
			},
			"suspicious": {
				"noUnknownAtRules": "off",
				"noConsole": "off",
				"useIterableCallbackReturn": "off",
				"noArrayIndexKey": "off",
				"noImplicitAnyLet": "off",
				// `== null` deliberately matches null and undefined.
				"noEqualsToNull": "off",
				// Vault, crypto, and importer code re-checks untrusted data that its types claim is valid.
				"noUnnecessaryConditions": "off",
				// Dropping `async` turns rejections into synchronous throws for callers.
				"useAwait": "off"
			},
			"style": {
				"noMagicNumbers": "off",
				"useBlockStatements": "off",
				"noNestedTernary": "off",
				"noIncrementDecrement": "off",
				"useDestructuring": "off"
			},
			"complexity": {
				"noForEach": "off",
				"noExcessiveCognitiveComplexity": "off",
				"useSimplifiedLogicExpression": "off",
				// `void promise` marks intentional fire-and-forget calls.
				"noVoid": "off"
			},
			"performance": {
				"noBarrelFile": "off",
				"noJsxPropsBind": "off",
				// Vault pushes and imports run sequentially on purpose.
				"noAwaitInLoops": "off",
				// Its autofix leaves undefined-valued keys behind.
				"noDelete": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"nursery": {
				"useSortedClasses": "warn"
			}
		},
		"domains": {
			"next": "recommended",
			"react": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				// Object key order is meaningful in places, e.g. table feature registration.
				"useSortedKeys": "off"
			}
		}
	},
	"overrides": [
		{
			// Binary SSH key parsing needs bitwise math and advancing offset parameters.
			"includes": ["src/lib/ssh-key-parser.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noBitwiseOperators": "off"
					},
					"style": {
						"noParameterAssign": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/ui/input-group.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off",
						"noNoninteractiveElementInteractions": "off"
					}
				}
			}
		}
	]
}
